{
  "multipart": [
    {
      "when": { "mode": "compare", "facing": "north" },
      "apply": { "model": "minecraft:block/comparator/mode/compare", "y": 180 }
    },
    {
      "when": { "mode": "subtract", "facing": "north" },
      "apply": { "model": "minecraft:block/comparator/mode/subtract", "y": 180 }
    },
    {
      "when": { "powered": "true", "facing": "north" },
      "apply": { "model": "minecraft:block/comparator/power/on", "y": 180 }
    },
    {
      "when": { "powered": "false", "facing": "north" },
      "apply": { "model": "minecraft:block/comparator/power/off", "y": 180 }
    },

    {
      "when": { "mode": "compare", "facing": "south" },
      "apply": { "model": "minecraft:block/comparator/mode/compare" }
    },
    {
      "when": { "mode": "subtract", "facing": "south" },
      "apply": { "model": "minecraft:block/comparator/mode/subtract" }
    },
    {
      "when": { "powered": "true", "facing": "south" },
      "apply": { "model": "minecraft:block/comparator/power/on" }
    },
    {
      "when": { "powered": "false", "facing": "south" },
      "apply": { "model": "minecraft:block/comparator/power/off" }
    },

    {
      "when": { "mode": "compare", "facing": "east" },
      "apply": { "model": "minecraft:block/comparator/mode/compare", "y": 270 }
    },
    {
      "when": { "mode": "subtract", "facing": "east" },
      "apply": { "model": "minecraft:block/comparator/mode/subtract", "y": 270 }
    },
    {
      "when": { "powered": "true", "facing": "east" },
      "apply": { "model": "minecraft:block/comparator/power/on", "y": 270 }
    },
    {
      "when": { "powered": "false", "facing": "east" },
      "apply": { "model": "minecraft:block/comparator/power/off", "y": 270 }
    },

    {
      "when": { "mode": "compare", "facing": "west" },
      "apply": { "model": "minecraft:block/comparator/mode/compare", "y": 90 }
    },
    {
      "when": { "mode": "subtract", "facing": "west" },
      "apply": { "model": "minecraft:block/comparator/mode/subtract", "y": 90 }
    },
    {
      "when": { "powered": "true", "facing": "west" },
      "apply": { "model": "minecraft:block/comparator/power/on", "y": 90 }
    },
    {
      "when": { "powered": "false", "facing": "west" },
      "apply": { "model": "minecraft:block/comparator/power/off", "y": 90 }
    }
  ]
}
